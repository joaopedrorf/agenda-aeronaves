SECRET_KEY=troque-por-uma-frase-longa-e-secreta
# DEMO=1 cria dados de exemplo quando o banco está vazio
DEMO=1
# Sem DATABASE_URL usa SQLite local (arquivo instance/agendamento.db)
# DATABASE_URL=postgresql://usuario:senha@host/banco
# Fuso horário do aeroclube (o servidor pode estar em outro país)
FUSO_HORARIO=America/Sao_Paulo
# Avisos de vencimento por e-mail (sem SMTP_HOST os avisos são só simulados)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
# SMTP_USUARIO=
# SMTP_SENHA=
# EMAIL_REMETENTE=avisos@seuaeroclube.com.br
# Senha do envio diário pelo GitHub Actions (ver .github/workflows/avisos.yml)
# AVISOS_TOKEN=
